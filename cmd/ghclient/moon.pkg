import {
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
  "tanabe1478/github-client-activity-sync" @activity_sync,
  "tanabe1478/github-client-credential-store" @credential_store,
  "tanabe1478/github-client-domain" @domain,
  "tanabe1478/github-client-github-api" @github_api,
  "tanabe1478/github-client-repository-store" @repository_store,
  "tanabe1478/github-client-review-request-store" @review_request_store,
  "tanabe1478/github-client-read-state-store" @read_state_store,
  "tanabe1478/github-client-triage-store" @triage_store,
  "tanabe1478/github-client-settings-store" @settings_store,
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  "native-stub": [ "stderr.c" ],
  link: {
    "native": {
      "cc": "${build.GITHUB_CLIENT_CC}",
      "cc-link-flags": "${build.GITHUB_CLIENT_CLI_LIBS}",
    },
  },
)
