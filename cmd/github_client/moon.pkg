import {
  "mizchi/glfw",
  "tanabe1478/github-client/app",
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  link: {
    "native": {
      "cc": "${build.GITHUB_CLIENT_CC}",
      "cc-flags": "${build.GITHUB_CLIENT_GLFW_CFLAGS}",
      "cc-link-flags": "${build.GITHUB_CLIENT_GLFW_LIBS}",
      "stub-cc": "${build.GITHUB_CLIENT_CXX}",
      "stub-cc-flags": "${build.GITHUB_CLIENT_GLFW_CFLAGS} ${build.GITHUB_CLIENT_IMGUI_CXXFLAGS}",
    },
  },
  "native-stub": [ "imgui_bridge.cpp" ],
  targets: { "main.mbt": [ "native" ], "imgui_bridge.mbt": [ "native" ] },
)
