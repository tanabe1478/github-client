import {
  "mizchi/glfw",
  "moonbitlang/async",
  "moonbit-community/proton_shell" @shell,
  "tanabe1478/github-client-credential-store" @credential_store,
  "tanabe1478/github-client-domain" @domain,
  "tanabe1478/github-client-github-api" @github_api,
  "tanabe1478/github-client-repository-store" @repository_store,
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  link: {
    "native": {
      "cc": "${build.GITHUB_CLIENT_CC}",
      "cc-flags": "${build.GITHUB_CLIENT_GLFW_CFLAGS}",
      "cc-link-flags": "${build.GITHUB_CLIENT_GLFW_LIBS}",
      "stub-cc": "${build.GITHUB_CLIENT_CXX}",
      "stub-cc-flags": "${build.GITHUB_CLIENT_GLFW_CFLAGS} ${build.GITHUB_CLIENT_IMGUI_CXXFLAGS}",
    },
  },
  "native-stub": [ "imgui_bridge.cpp" ],
  targets: { "main.mbt": [ "native" ], "imgui_bridge.mbt": [ "native" ] },
)
