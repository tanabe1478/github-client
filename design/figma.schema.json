{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Client Figma Binding",
  "type": "object",
  "required": ["version", "status", "file", "sourceOfTruth", "figmaNodes", "sync", "surfaces", "tokens"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["unbound", "partial", "active", "archived"] },
    "file": {
      "type": "object",
      "required": ["url", "key", "name"],
      "properties": {
        "url": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sourceOfTruth": {
      "type": "object",
      "required": ["visualDesign", "behaviorAndAccessibility", "implementationEvidence"],
      "additionalProperties": { "type": "string" }
    },
    "figmaNodes": {
      "type": "object",
      "properties": {
        "cover": { "type": "string" },
        "foundations": { "type": "string" },
        "components": { "type": "object", "additionalProperties": { "type": "string" } },
        "pages": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "required": ["state", "completedPhases", "pendingPhases"],
      "properties": {
        "state": { "enum": ["pending", "blocked", "synchronized"] },
        "reason": { "type": "string" },
        "completedPhases": { "type": "array", "items": { "type": "string" } },
        "pendingPhases": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "figmaNodeId", "implementation", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "figmaNodeId": { "type": "string" },
          "implementation": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "evidence": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "tokens": { "type": "string", "minLength": 1 },
    "lastReviewedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
